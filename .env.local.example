# ============================================================
# AgendamentoIA — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local com valores reais.
# ============================================================

# --- Supabase -------------------------------------------------
# URL do projeto Supabase (ex.: https://xyzcompany.supabase.co)
# Valor de dev (Poseidon): https://anirmcbdnzwwlqtxpwng.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública). Usada no browser e em Server Components.
# Valor de dev (Poseidon): eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. APENAS server-side, nunca em código do browser
# (ver lib/supabase/admin.ts). Não exponha no frontend.
# Obtida em Supabase Dashboard > Project Settings > API.
# Valor de dev: get-from-supabase-dashboard-settings-api (placeholder)
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---------------------------------------------------
# Chave da API OpenAI (GPT-4o com function calling). Server-side.
OPENAI_API_KEY=

# Modelo a usar (opcional; padrão: gpt-4o)
OPENAI_MODEL=gpt-4o

# --- Evolution API --------------------------------------------
# URL base da instância self-hosted (ex.: http://localhost:8080)
EVOLUTION_API_URL=

# API key da Evolution API (global key ou de instância). Server-side.
EVOLUTION_API_KEY=

# Segredo para validar a origem dos webhooks da Evolution API
# (opcional, mas recomendado). Enviado como header "x-webhook-secret".
EVOLUTION_WEBHOOK_SECRET=

# --- Cron / Lembretes -----------------------------------------
# Segredo exigido no header "Authorization: Bearer <valor>" das rotas
# de cron (ex.: /api/cron/reminders). Nunca exponha no frontend.
CRON_SECRET=

# Janela (em horas) antes do início do agendamento para enviar lembrete.
REMINDER_WINDOW_HOURS=24

# --- App ------------------------------------------------------
# URL pública da aplicação (usada em links de redirecionamento se precisar)
NEXT_PUBLIC_APP_URL=http://localhost:3000